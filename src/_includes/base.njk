<!DOCTYPE html>
<html lang="{{ t.htmlLang }}"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#ffffff">
<title>{{ title }}</title>
<link rel="canonical" href="{{ site.url }}{{ routes[key][lang] }}">
<link rel="alternate" hreflang="es-CL" href="{{ site.url }}{{ routes[key].es }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ routes[key].en }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ routes[key].es }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ t.ogLocale }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ routes[key][lang] }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-default.png">
<meta property="og:site_name" content="Lontra">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}/assets/img/og-default.png">
{%- for block in ld %}
<script type="application/ld+json">
{{ block | dump(2) | safe }}
</script>
{%- endfor %}
<link rel="stylesheet" href="{{ '/assets/css/built.css' | hashed }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
</head>
<body class="bg-[#f8f9fc] text-slate-900 overflow-x-hidden">
{%- if spotlight %}
<div id="spotlight"></div>
{%- endif %}
{% include "nav.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
<script src="{{ '/assets/js/site.js' | hashed }}"></script>
</body>
</html>
